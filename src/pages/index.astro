---
import AtlasTerrain from '../components/AtlasTerrain.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LandscapePreview from '../components/LandscapePreview.astro';
import TechnologyCard from '../components/TechnologyCard.astro';
import { categories, getRelations, getTechnologies } from '../data/load';
import { featuredJourneys, journeys } from '../data/journeys';
import { withBase } from '../lib/paths';
import type { Technology } from '../data/schema';
import '../styles/home-atlas.css';

const technologies = getTechnologies();
const relations = getRelations();
const featured = ['astro', 'hono', 'react', 'cloudflare-workers']
  .map((id) => technologies.find((technology) => technology.id === id))
  .filter((technology): technology is Technology => Boolean(technology));
const comparisons = [
  { type: 'Direct comparison', title: 'Astro vs Next.js', body: '同じWebフレームワーク層。何を優先するかで選択が変わる。', href: '/compare/astro/nextjs' },
  { type: 'Different layers', title: 'Astro vs Hono', body: 'サイト全体とサーバー処理。競合ではなく役割分担を見る。', href: '/compare/astro/hono' },
  { type: 'Built on', title: 'React vs Next.js', body: 'UIライブラリと、それを土台に使うWebフレームワーク。', href: '/compare/nextjs/react' }
];
const startPaths = [
  { number: '01', title: '技術を探す', body: '名前や役割、ecosystemから索引を引く。知らない技術の「何者？」を確認したいときに。', href: '/technologies', arrow: 'Explorerへ' },
  { number: '02', title: '違いを比べる', body: '二つの技術が本当に競合するのか、別の層なのかを役割から見比べる。', href: '/compare/astro/nextjs', arrow: '比較を見る' },
  { number: '03', title: '作りたいものから辿る', body: 'ブログやAPIなど目的を出発点に、代表的な構成と選択理由を航路として辿る。', href: '/journeys', arrow: 'Journeyへ' },
];
---
<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-layout">
      <div class="hero-copy">
        <div class="meta-label accent-label">WEB TECHNOLOGY ATLAS</div>
        <h1 class="display-title">Web技術の地図を、一緒に旅しよう。</h1>
        <p class="hero-description">技術を知り、比べ、つなげて、あなたの次の一歩を見つける。名前の暗記ではなく、役割と関係からWeb技術の世界を眺める地図です。</p>
        <div class="hero-actions">
          <a class="button-primary" href={withBase('/landscape')}>地図を開く</a>
          <a class="button-secondary" href={withBase('/technologies')}>技術を探す</a>
        </div>
        <div class="hero-metrics" aria-label="収録情報">
          <div class="hero-metric"><strong>{technologies.length}</strong><span>TECHNOLOGIES</span></div>
          <div class="hero-metric"><strong>{categories.length}</strong><span>CATEGORIES</span></div>
          <div class="hero-metric"><strong>{relations.length}</strong><span>RELATIONS</span></div>
          <div class="hero-metric"><strong>{journeys.length}</strong><span>JOURNEYS</span></div>
        </div>
      </div>
      <AtlasTerrain />
    </div>
  </section>

  <section class="section home-atlas-section">
    <div class="shell">
      <div class="section-header">
        <div class="section-header-copy">
          <div class="meta-label">01 / TECHNOLOGY ATLAS</div>
          <h2 class="section-title">まず、Web技術の世界を6つの地域で眺める。</h2>
        </div>
        <p class="section-description">22カテゴリを大きな役割地域にまとめています。名前を追う前に、どこで何を担当する技術なのかを掴めます。</p>
      </div>
      <LandscapePreview technologies={technologies} />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-header">
        <div class="section-header-copy">
          <div class="meta-label">02 / CHOOSE YOUR ROUTE</div>
          <h2 class="section-title">今知りたいことから、入口を選ぶ。</h2>
        </div>
        <p class="section-description">全技術を順番に読む必要はありません。探す、比べる、作りたいものから辿る。目的に合う入口から始められます。</p>
      </div>
      <div class="start-path-grid">
        {startPaths.map((path) => (
          <a class="start-path-card" href={withBase(path.href)}>
            <span class="start-path-number">ROUTE {path.number}</span>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <span class="start-path-arrow">{path.arrow} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-header">
        <div><div class="meta-label">03 / START HERE</div><h2 class="section-title">よく遭遇する技術から現在地を掴む。</h2></div>
        <a class="section-link" href={withBase('/technologies')}>すべての技術を見る →</a>
      </div>
      <div class="tech-grid">{featured.map((technology) => <TechnologyCard technology={technology} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-header">
        <div><div class="meta-label">04 / COMPARE</div><h2 class="section-title">「どっちが良い？」の前に、同じ土俵かを見る。</h2></div>
      </div>
      <div class="compare-preview-grid">
        {comparisons.map((comparison) => (
          <a class="compare-preview" href={withBase(comparison.href)}>
            <span class="compare-preview-type">{comparison.type}</span>
            <h3>{comparison.title}</h3>
            <p>{comparison.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-header">
        <div><div class="meta-label">05 / JOURNEYS</div><h2 class="section-title">作りたいものから、必要な技術だけ辿る。</h2></div>
        <a class="section-link" href={withBase('/journeys')}>すべてのJourneyを見る →</a>
      </div>
      <div class="journey-preview-grid">
        {featuredJourneys.map((journey, index) => (
          <a class="journey-preview" href={withBase(`/journeys/${journey.id}`)}>
            <span class="journey-index">0{index + 1}</span>
            <div><h3>{journey.title}</h3><p>{journey.summary}</p></div>
            <span class="journey-preview-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="open-source-panel">
        <div>
          <div class="meta-label accent-label">OPEN SOURCE</div>
          <h2>この地図そのものを、GitHubで育てる。</h2>
          <p>技術説明と関係データは公開リポジトリが正本。足りない技術や関係の修正を、そのままPull Requestで提案できます。</p>
        </div>
        <a class="button-secondary" href="https://github.com/kota-kagarist/tech-adventure" rel="noreferrer">View repository ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
