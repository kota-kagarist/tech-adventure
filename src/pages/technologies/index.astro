---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnologyCard from '../../components/TechnologyCard.astro';
import { categories, ecosystems, getTechnologies } from '../../data/load';
import { withBase } from '../../lib/paths';
const technologies = getTechnologies();
---
<BaseLayout title="技術を探す" description="Web技術を役割ごとに整理し、何を担当する道具なのかを確認できます。">
  <header class="page-head shell">
    <div class="breadcrumb"><a href={withBase('/')}>Home</a> / Technologies</div>
    <div class="meta-label accent-label">TECHNOLOGY EXPLORER</div>
    <h1>技術を、役割から探す。</h1>
    <p>名前の人気ではなく「何を担当する道具か」で並べています。同じカテゴリなら比較候補、違うカテゴリなら組み合わせ候補かもしれません。</p>
  </header>
  <section class="section">
    <div class="shell">
      <div class="explorer-toolbar" aria-label="技術を絞り込む">
        <input data-tech-search type="search" placeholder="Search Astro, API, database..." aria-label="技術名や説明を検索" />
        <select data-tech-category aria-label="カテゴリで絞り込む">
          <option value="">すべてのカテゴリ</option>
          {categories.map((category) => <option value={category.id}>{category.name}</option>)}
        </select>
        <select data-tech-ecosystem aria-label="エコシステムで絞り込む">
          <option value="">すべてのecosystem</option>
          {ecosystems.map((ecosystem) => <option value={ecosystem.id}>{ecosystem.name}</option>)}
        </select>
        <select data-tech-maturity aria-label="成熟度で絞り込む">
          <option value="">すべての成熟度</option>
          <option value="mature">Mature</option>
          <option value="established">Established</option>
          <option value="emerging">Emerging</option>
        </select>
        <select data-tech-importance aria-label="主要度で絞り込む">
          <option value="">すべての主要度</option>
          <option value="core">Core</option>
          <option value="major">Major</option>
        </select>
        <p class="explorer-count" data-tech-count>{technologies.length} technologies</p>
      </div>
      {categories.map((category) => {
        const items = technologies.filter((technology) => technology.category === category.id);
        if (items.length === 0) return null;
        return (
          <section class="tech-section" data-tech-section data-category={category.id}>
            <div class="tech-section-header">
              <div><div class="meta-label">{category.id}</div><h2>{category.name}</h2></div>
              <p>{category.description}</p>
            </div>
            <div class="tech-grid">{items.map((technology) => <TechnologyCard technology={technology} />)}</div>
          </section>
        );
      })}
    </div>
  </section>
  <script>
    import { filterTechnologies } from '../../lib/explorer.mjs';

    const searchInput = document.querySelector('[data-tech-search]');
    const categorySelect = document.querySelector('[data-tech-category]');
    const ecosystemSelect = document.querySelector('[data-tech-ecosystem]');
    const maturitySelect = document.querySelector('[data-tech-maturity]');
    const importanceSelect = document.querySelector('[data-tech-importance]');
    const cards = [...document.querySelectorAll('[data-tech-card]')];
    const sections = [...document.querySelectorAll('[data-tech-section]')];
    const count = document.querySelector('[data-tech-count]');
    const records = cards.filter((card) => card instanceof HTMLElement).map((card) => ({
      id: card.dataset.id ?? '',
      name: card.dataset.name ?? '',
      shortDescription: card.dataset.description ?? '',
      role: card.dataset.role ?? '',
      category: card.dataset.category ?? '',
      ecosystem: card.dataset.ecosystems?.split('|').filter(Boolean) ?? [],
      maturity: card.dataset.maturity ?? '',
      importance: card.dataset.importance ?? '',
      aliases: card.dataset.aliases?.split('|').filter(Boolean) ?? [],
      tags: card.dataset.tags?.split('|').filter(Boolean) ?? []
    }));
    const params = new URLSearchParams(window.location.search);
    const controls = {
      query: searchInput,
      category: categorySelect,
      ecosystem: ecosystemSelect,
      maturity: maturitySelect,
      importance: importanceSelect
    };
    for (const [key, control] of Object.entries(controls)) {
      const value = params.get(key) ?? '';
      if (control instanceof HTMLInputElement) control.value = value;
      if (control instanceof HTMLSelectElement && [...control.options].some((option) => option.value === value)) control.value = value;
    }
    function applyFilters() {
      const filters = {
        query: searchInput instanceof HTMLInputElement ? searchInput.value : '',
        category: categorySelect instanceof HTMLSelectElement ? categorySelect.value : '',
        ecosystem: ecosystemSelect instanceof HTMLSelectElement ? ecosystemSelect.value : '',
        maturity: maturitySelect instanceof HTMLSelectElement ? maturitySelect.value : '',
        importance: importanceSelect instanceof HTMLSelectElement ? importanceSelect.value : ''
      };
      const visibleIds = new Set(filterTechnologies(records, filters).map((technology: { id: string }) => technology.id));
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        card.hidden = !visibleIds.has(card.dataset.id ?? '');
      }
      for (const section of sections) {
        if (section instanceof HTMLElement) section.hidden = !section.querySelector('[data-tech-card]:not([hidden])');
      }
      if (count) count.textContent = `${visibleIds.size} technologies`;
      const nextParams = new URLSearchParams();
      for (const [key, value] of Object.entries(filters)) if (value) nextParams.set(key, value);
      const nextQuery = nextParams.toString();
      window.history.replaceState({}, '', `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ''}`);
    }
    for (const control of Object.values(controls)) {
      control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', applyFilters);
    }
    applyFilters();
  </script>
</BaseLayout>
