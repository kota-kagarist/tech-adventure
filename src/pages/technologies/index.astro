---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnologyCard from '../../components/TechnologyCard.astro';
import { categories, getTechnologies } from '../../data/load';
const technologies = getTechnologies();
---
<BaseLayout title="技術を探す" description="Web技術を役割ごとに整理し、何を担当する道具なのかを確認できます。">
<header class="page-head shell"><div class="breadcrumb"><a href="/">Home</a> / Technologies</div><div class="kicker">TECHNOLOGY ATLAS</div><h1>技術を、役割から探す。</h1><p>名前の人気ではなく「何を担当する道具か」で並べています。同じカテゴリなら比較候補、違うカテゴリなら組み合わせ候補かもしれません。</p></header>
<section class="section"><div class="shell"><div class="filter-bar" aria-label="技術を絞り込む"><input data-tech-search type="search" placeholder="Astro、API、database..." aria-label="技術名や説明を検索" /><select data-tech-category aria-label="カテゴリで絞り込む"><option value="">すべてのカテゴリ</option>{categories.map((category) => <option value={category.id}>{category.name}</option>)}</select></div><p class="muted" data-tech-count>{technologies.length}件の技術</p>{categories.map((category) => { const items = technologies.filter((technology) => technology.category === category.id); if (items.length === 0) return null; return <section class="tech-section" data-tech-section data-category={category.id}><div class="section-head"><div><div class="kicker">{category.id}</div><h2>{category.name}</h2></div><p class="muted">{category.description}</p></div><div class="tech-grid">{items.map((technology) => <TechnologyCard technology={technology} />)}</div></section>; })}</div></section>
<script>
const searchInput = document.querySelector('[data-tech-search]');
const categorySelect = document.querySelector('[data-tech-category]');
const cards = [...document.querySelectorAll('[data-tech-card]')];
const sections = [...document.querySelectorAll('[data-tech-section]')];
const count = document.querySelector('[data-tech-count]');
const initialCategory = new URLSearchParams(window.location.search).get('category') ?? '';
if (categorySelect instanceof HTMLSelectElement && [...categorySelect.options].some((option) => option.value === initialCategory)) categorySelect.value = initialCategory;
function applyFilters() {
  const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
  const category = categorySelect instanceof HTMLSelectElement ? categorySelect.value : '';
  let visible = 0;
  for (const card of cards) { if (!(card instanceof HTMLElement)) continue; const matchesQuery = !query || Boolean(card.textContent?.toLowerCase().includes(query)) || Boolean(card.dataset.name?.includes(query)); const matchesCategory = !category || card.dataset.category === category; card.hidden = !(matchesQuery && matchesCategory); if (!card.hidden) visible += 1; }
  for (const section of sections) { if (section instanceof HTMLElement) section.hidden = !section.querySelector('[data-tech-card]:not([hidden])'); }
  if (count) count.textContent = `${visible}件の技術`;
}
searchInput?.addEventListener('input', applyFilters); categorySelect?.addEventListener('change', applyFilters); applyFilters();
</script>
</BaseLayout>
