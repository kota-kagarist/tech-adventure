---
import { landscapeRegions } from '../data/landscape';
import { withBase } from '../lib/paths';
import TechnologyIcon from './TechnologyIcon.astro';
import type { Technology } from '../data/schema';

interface Props { technologies: Technology[]; }
const { technologies } = Astro.props;

const groups = landscapeRegions.map((region) => {
  const regionTechnologies = technologies.filter((technology) => region.categories.includes(technology.category));
  const core = regionTechnologies.filter((technology) => technology.importance === 'core');
  const representatives = [...core, ...regionTechnologies.filter((technology) => technology.importance !== 'core')].slice(0, 3);
  return { ...region, count: regionTechnologies.length, representatives };
});
---
<div class="landscape-panel atlas-preview" aria-label="技術世界の6地域">
  <div class="landscape-chrome">
    <span>TECH ADVENTURE / ATLAS</span>
    <span>6 REGIONS · ROLE → RELATION → PURPOSE</span>
  </div>
  <div class="landscape-grid atlas-preview-grid">
    {groups.map((group, index) => (
      <section class="landscape-region-card" data-region={group.id} aria-label={`${group.label} ${group.name}`}>
        <div class="landscape-region-card-top">
          <span class="landscape-region-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="landscape-region-count">{group.count} TECH</span>
        </div>
        <div>
          <div class="meta-label">{group.label}</div>
          <h3>{group.name}</h3>
          <p>{group.description}</p>
        </div>
        <div class="landscape-region-icons" aria-label="代表技術">
          {group.representatives.map((technology) => (
            <a href={withBase(`/technologies/${technology.id}`)} aria-label={`${technology.name} の詳細`} title={technology.name}>
              <TechnologyIcon technology={technology} size="small" />
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <div class="landscape-footer">
    <span>{technologies.length} technologies / 22 categories</span>
    <a href={withBase('/landscape')}>地図をすべて開く →</a>
  </div>
</div>
