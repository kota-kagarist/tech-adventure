---
import { withBase } from '../lib/paths';
import TechnologyIcon from './TechnologyIcon.astro';
import type { Technology } from '../data/schema';

interface Props { technologies: Technology[]; }
const { technologies } = Astro.props;
const byId = new Map(technologies.map((technology) => [technology.id, technology]));
const groups = [
  { label: 'LANGUAGE', ids: ['javascript', 'typescript'] },
  { label: 'UI', ids: ['react', 'vue', 'svelte'] },
  { label: 'FRAMEWORK', ids: ['astro', 'nextjs', 'nuxt'] },
  { label: 'SERVER', ids: ['hono', 'fastify', 'express'] },
  { label: 'RUNTIME', ids: ['nodejs', 'bun', 'deno'] },
  { label: 'DATA', ids: ['postgresql', 'sqlite', 'cloudflare-d1'] }
];
---
<div class="landscape-panel" aria-label="技術世界のプレビュー">
  <div class="landscape-chrome">
    <span>TECH ADVENTURE / LANDSCAPE</span>
    <span>ROLE → RELATION → PURPOSE</span>
  </div>
  <div class="landscape-scroll">
    <div class="landscape-grid">
      {groups.map((group) => (
        <section class="landscape-group" aria-label={group.label}>
          <div class="landscape-group-label">{group.label}</div>
          <div class="landscape-node-list">
            {group.ids.map((id) => {
              const technology = byId.get(id);
              if (!technology) return null;
              return <a class="landscape-node" href={withBase(`/technologies/${technology.id}`)}><TechnologyIcon technology={technology} size="small" /><span>{technology.name}</span></a>;
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
  <div class="landscape-footer">
    <span>18 representative nodes</span>
    <a href={withBase('/technologies')}>Explore all technologies →</a>
  </div>
</div>
