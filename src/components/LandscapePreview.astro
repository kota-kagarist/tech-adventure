---
import { landscapeRegions } from '../data/landscape';
import { withBase } from '../lib/paths';
import TechnologyIcon from './TechnologyIcon.astro';
import type { Technology } from '../data/schema';

interface Props { technologies: Technology[]; }
const { technologies } = Astro.props;

const groups = landscapeRegions.map((region) => {
  const regionTechnologies = technologies.filter((technology) => region.categories.includes(technology.category));
  const core = regionTechnologies.filter((technology) => technology.importance === 'core');
  const representatives = [...core, ...regionTechnologies.filter((technology) => technology.importance !== 'core')].slice(0, 3);
  return { ...region, count: regionTechnologies.length, representatives };
});
---
<div class="landscape-panel" aria-label="技術世界のプレビュー">
  <div class="landscape-chrome">
    <span>TECH ADVENTURE / LANDSCAPE</span>
    <span>ROLE → RELATION → PURPOSE</span>
  </div>
  <div class="landscape-scroll">
    <div class="landscape-grid">
      {groups.map((group) => (
        <section class="landscape-group" aria-label={group.label}>
          <div class="landscape-group-label">
            <span>{group.label}</span>
            <small>{group.count} TECH</small>
          </div>
          <div class="landscape-node-list">
            {group.representatives.map((technology) => (
              <a class="landscape-node" href={withBase(`/technologies/${technology.id}`)}>
                <TechnologyIcon technology={technology} size="small" />
                <span>{technology.name}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
  <div class="landscape-footer">
    <span>6 regions / {technologies.length} technologies</span>
    <a href={withBase('/landscape')}>Open full atlas →</a>
  </div>
</div>
