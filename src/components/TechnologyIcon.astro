---
import { resolveTechnologyIcon } from '../lib/technology-icons.mjs';
import { withBase } from '../lib/paths';
import type { Technology } from '../data/schema';

interface Props {
  technology: Technology;
  size?: 'small' | 'medium' | 'large';
}

const { technology, size = 'medium' } = Astro.props;
const icon = resolveTechnologyIcon(technology);
const numericColor = Number.parseInt(icon.hex, 16);
const red = (numericColor >> 16) & 255;
const green = (numericColor >> 8) & 255;
const blue = numericColor & 255;
const luminance = (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255;
const ink = luminance < 0.28 ? 'F5F3FF' : icon.hex;
const style = `--technology-icon-brand:#${icon.hex};--technology-icon-ink:#${ink}`;
const invertArtwork = icon.kind === 'brand' && icon.source !== 'official' && luminance < 0.28;
---
<span
  class:list={['technology-icon', `technology-icon--${size}`, icon.kind === 'fallback' && 'technology-icon--fallback', invertArtwork && 'technology-icon--invert']}
  data-icon-source={icon.kind === 'brand' ? icon.source : 'fallback'}
  style={style}
  aria-hidden="true"
>
  {icon.kind === 'brand' && <img class="technology-icon-art" src={withBase(`/icons/${technology.id}.svg`)} alt="" width="40" height="40" loading={size === 'large' ? 'eager' : 'lazy'} decoding="async" />}
  {icon.kind === 'fallback' && <span class="technology-icon-label">{icon.label}</span>}
</span>
