---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { canonicalPageUrl, projectAssetUrl, projectRootUrl } from '../lib/site-urls.mjs';
import '../styles/global.css';
import '../styles/mobile-layout.css';
import '../styles/layout-polish.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Tech Adventure',
  description = '技術の世界を、役割・競合・組み合わせから理解するオープンなテクノロジーガイド。',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Tech Adventure' ? title : `${title} | Tech Adventure`;
const fallbackSite = new URL('https://kota-kagarist.github.io');
const site = Astro.site ?? fallbackSite;
const projectRoot = projectRootUrl(site, import.meta.env.BASE_URL);
const canonicalUrl = canonicalPageUrl(site, import.meta.env.BASE_URL, Astro.url.pathname).href;
const socialImageUrl = projectAssetUrl(site, import.meta.env.BASE_URL, 'social-preview.png').href;
const creatorId = `${projectRoot.href}#creator`;
const websiteId = `${projectRoot.href}#website`;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Tech Adventure',
      url: projectRoot.href,
      description: 'Web技術の役割・比較・組み合わせ・経路を理解するためのオープンなTechnology Atlas。',
      inLanguage: 'ja-JP',
      creator: { '@id': creatorId },
    },
    {
      '@type': 'Person',
      '@id': creatorId,
      name: 'Kota Tsuda',
      alternateName: 'kagarist',
      url: 'https://github.com/kota-kagarist',
      sameAs: ['https://github.com/kota-kagarist'],
    },
  ],
}).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F6F7F4" />
    <meta name="description" content={description} />
    <meta name="author" content="Kota Tsuda / kagarist" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href="https://github.com/kota-kagarist" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Tech Adventure" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tech Adventure — Web Technology Atlas by kagarist / Kota Tsuda" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
